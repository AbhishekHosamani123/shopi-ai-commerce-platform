# =============================================
# BACKEND (server-side: used by server actions + merchant proxy)
# Local dev: http://localhost:3500 | Production: https://your-backend.onrender.com
# =============================================
BACKEND_URL=http://localhost:3500
API_SECRET=your_random_api_secret

# =============================================
# GOOGLE OAUTH (Public)
# =============================================
NEXT_PUBLIC_FRONTEND_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# =============================================
# RAZORPAY (Public Key ID)
# =============================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# =============================================
# STRIPE (Legacy Public)
# =============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# =============================================
# DOMAIN (Public)
# =============================================
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# =============================================
# PRODUCTION OVERRIDES (set these in Vercel)
# =============================================
# Optional: publish the backend origin to the browser ONLY for the wake-up
# beacon. If unset, the beacon uses the same-origin /health passthrough.
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com
NEXT_PUBLIC_DOMAIN=https://your-storefront.vercel.app
