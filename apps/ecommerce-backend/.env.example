# =============================================
# DATABASE
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_database_password
DB_NAME=ecommerce

# =============================================
# SERVER
# =============================================
PORT=3500
FRONTEND_SERVER_ORIGIN=http://localhost:3000

# =============================================
# JWT
# =============================================
JWT_ENCRYPTION_KEY=your_jwt_encryption_key

# =============================================
# API SECRET (shared with Client's API_SECRET)
# =============================================
API_SECRET=your_random_api_secret

# =============================================
# SMTP EMAIL
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_SENDERNAME=Your Store Name
SMTP_SUPPORT=support@yourdomain.com

# =============================================
# PAYMENTS (Razorpay Test Configuration)
# =============================================
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# =============================================
# PAYMENTS (Legacy Stripe Test Configuration)
# =============================================
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_exampley

# =============================================
# GOOGLE OAUTH
# =============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================
# WHATSAPP DELIVERY CHANNEL (Evolution API / Baileys)
# =============================================
# Locally hosted Evolution API instance (clone: https://github.com/evolution-foundation/evolution-api)
EVOLUTION_API_URL=http://localhost:8080
# Must match AUTHENTICATION_API_KEY in evolution-api/.env
EVOLUTION_API_KEY=your_evolution_api_key
# DRY_RUN (default, safe) or LIVE (real WhatsApp sends; also needs COMMUNICATION_MODE=PRODUCTION)
WHATSAPP_SEND_MODE=DRY_RUN
# Neutral Evolution instance name for the QR-connected SENDER WhatsApp account
WHATSAPP_SENDER_INSTANCE=shopi-buildathon-whatsapp
# HARD RECIPIENT ALLOWLIST: the ONLY numbers permitted to receive WhatsApp
# messages in this Buildathon demo (all other recipients are refused)
WHATSAPP_ALLOWED_RECIPIENTS=+918431406956,+916366475180

# =============================================
# CAMPAIGN BANNER GENERATOR (Python/Pillow)
# =============================================
PYTHON_BIN=python
# Optional custom output dir for generated banners; defaults to generated_campaign_assets/
BANNER_OUTPUT_DIR=

# =============================================
# STOREFRONT PUBLIC URL (production CTA links, emails)
# =============================================
STOREFRONT_BASE_URL=https://your-storefront.vercel.app

# =============================================
# COMMUNICATION & EMAIL DELIVERY
# =============================================
# DRY_RUN (default, safe) | TEST (controlled, EMAIL_TEST_RECIPIENT only) | PRODUCTION
COMMUNICATION_MODE=DRY_RUN
EMAIL_PROVIDER=GMAIL_SMTP
EMAIL=your_gmail_sender@gmail.com
PASSWORD=your_gmail_app_password
EMAIL_TEST_RECIPIENT=authorized_test_recipient@gmail.com

# =============================================
# AI SHOPPING AGENT (Groq LLM)
# =============================================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
