{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_BACKEND_URL",
    "NEXT_PUBLIC_DOMAIN",
    "NEXT_PUBLIC_FRONTEND_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_RAZORPAY_KEY_ID",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "JWT_ENCRYPTION_KEY",
    "BACKEND_URL",
    "API_SECRET",
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASS",
    "DB_NAME",
    "PORT",
    "FRONTEND_SERVER_ORIGIN",
    "STOREFRONT_BASE_URL",
    "COMMUNICATION_MODE",
    "EMAIL_PROVIDER",
    "SMTP_HOST",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_SENDERNAME",
    "SMTP_SUPPORT",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "STRIPE_SECRET_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "EVOLUTION_API_URL",
    "EVOLUTION_API_KEY",
    "WHATSAPP_SEND_MODE",
    "WHATSAPP_SENDER_INSTANCE",
    "WHATSAPP_ALLOWED_RECIPIENTS",
    "PYTHON_BIN",
    "BANNER_OUTPUT_DIR",
    "EMAIL",
    "PASSWORD",
    "EMAIL_TEST_RECIPIENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "seed": {
      "outputs": []
    }
  }
}
